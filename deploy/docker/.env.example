# Solo se usa junto con docker-compose.nginx.yml (despliegue en la VM con
# HTTPS real). Para pruebas locales en el PC no hace falta este archivo.
#
# Copia esto a ".env" en esta misma carpeta y reemplaza con los valores
# reales antes de desplegar:
#   cp .env.example .env

# Dominio público de la APP (no el de Supabase, que tiene el suyo aparte
# en deploy/docker/supabase/.env) — ej. fieldsight.netmask.co
APP_DOMAIN=fieldsight.netmask.co

# Correo para el aviso de vencimiento de Let's Encrypt
CERTBOT_EMAIL=admin@netmask.co
