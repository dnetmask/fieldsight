<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config — SOLO para App Service en plan WINDOWS (IIS).
  Si tu App Service es Linux/Node, borra este archivo y usa
  server.js + package.json en su lugar.
-->
<configuration>
  <system.webServer>

    <!-- index.html como página de inicio -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Tipos MIME correctos para el manifest de la PWA -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!-- Permite que el service worker controle toda la app -->
    <httpProtocol>
      <customHeaders>
        <add name="Service-Worker-Allowed" value="/" />
      </customHeaders>
    </httpProtocol>

    <!--
      Forzar HTTPS. Nota: si ya activaste "HTTPS Only" en
      Azure Portal → tu App Service → Configuration → General settings,
      esta regla es redundante (pero inofensiva) — puedes borrarla.
    -->
    <rewrite>
      <rules>
        <rule name="Forzar HTTPS" enabled="true" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
